+#[cfg(unix)]
+#[tokio::test]
+async fn shutdown_closes_child_stdin_so_a_blocked_reader_exits_promptly() {
+    let temp = TempDir::new().expect("tempdir");
+    let script_path = temp.path().join("stdin-reader.sh");
+    // Models a runtime (Node) that cannot exit while a thread is blocked on
+    // stdin: after acknowledging shutdown it exits only once stdin hits EOF.
+    write_executable_script(
+        &script_path,
+        r#"#!/bin/sh
+IFS= read -r initialize
+printf '%s\n' '{"jsonrpc":"2.0","id":1,"result":{"api_version":"0.1","tools":[],"commands":[]}}'
+IFS= read -r shutdown
+printf '%s\n' '{"jsonrpc":"2.0","id":2,"result":{}}'
+cat > /dev/null
+"#,
+    );
+    let descriptor = trusted_descriptor(
+        temp.path(),
+        minimal_manifest("stdin-reader", "stdin-reader.sh"),
+    );
+    let mut config = ExtensionRuntimeConfig::new(temp.path());
+    config.shutdown_timeout = Duration::from_secs(5);
+    let process = ExtensionProcess::start(descriptor, config)
+        .await
+        .expect("start process");
+
+    let started = Instant::now();
+    assert!(process.shutdown().await, "child must exit gracefully");
+    assert!(
+        started.elapsed() < Duration::from_secs(2),
+        "shutdown waited out the exit timeout instead of closing stdin: {:?}",
+        started.elapsed()
+    );
+}
