+test('a background failure is one path-free line, once per distinct text, with the full text in the log', t => {
+  const { runtime, frames, diagnostics } = harness(t);
+  const error = new Error('Cannot find module /home/me/.octet/ext/keys.js\n    at stack frame /home/me/x.js:1:1');
+  for (let n = 0; n < 3; n++) runtime.backgroundError(error);
+  runtime.backgroundError(new Error('another'));
+  assert.deepEqual(frames.map(frame => frame.params.message), ['Cannot find module keys.js', 'another']);
+  assert.ok(frames.every(frame => frame.params.level === 'error'));
+  assert.equal(diagnostics.length, 4, 'every occurrence is logged');
+  assert.match(diagnostics[0], /\/home\/me\/\.octet\/ext\/keys\.js/);
+});
+
 test('more than four distinct problems end in one pointer to the details instead of a longer list', () => {
   const lines = formatIssues(Array.from({ length: 9 }, (_, n) => ({ path: `/x/e${n}.ts`, level: 'error', reason: `reason ${n}`, next: 'Act.' })));
   assert.equal(lines.length, 4);
