+#[tokio::test]
+async fn a_queued_extension_action_says_when_it_runs_without_scheduler_jargon() {
+    let mut shell = InteractiveShell::test_shell();
+    let (queue, _) = run_active_command(
+        &mut shell,
+        Command::Extensions(commands::ExtensionsSubcommand::Reload),
+        test_run_inspection(),
+    )
+    .await;
+    assert_eq!(queue.len(), 1);
+    let snapshot = shell.debug_snapshot();
+    assert!(snapshot.contains("extension action queued; it runs when the current response finishes"));
+    assert!(!snapshot.contains("idle boundary"));
+}
