diff --git a/crates/octet-coding-agent/src/tui/footer_placeholder.rs b/crates/octet-coding-agent/src/tui/footer_placeholder.rs
new file mode 100644
index 00000000..e8690640
--- /dev/null
+++ b/crates/octet-coding-agent/src/tui/footer_placeholder.rs
@@ -0,0 +1,135 @@
+//! Placeholder for an extension-owned footer while the extension loads.
+//!
+//! An extension that replaces the footer mounts it only after its process has
+//! started, seconds after the first frame. Showing octet's own footer until
+//! then makes the footer visibly swap. This keeps the plain text of the last
+//! live footer, per workspace, and draws it dimmed in the footer's place until
+//! the live component paints its first frame. It never carries styling, is only
+//! used at the width it was recorded at, and is dropped as soon as the live
+//! footer paints or startup settles without one.
+
+use std::path::{Path, PathBuf};
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+/// Rows kept per footer; a taller footer is not cached.
+const MAX_ROWS: usize = 8;
+/// Bytes kept per row.
+const MAX_ROW_BYTES: usize = 4096;
+
+#[derive(Clone, Debug, Default, Deserialize, Eq, PartialEq, Serialize)]
+pub(crate) struct FooterPlaceholder {
+    /// Terminal width the rows were recorded at.
+    pub(crate) columns: u16,
+    /// Sorted names of the extensions that were starting when it was recorded.
+    pub(crate) extensions: Vec<String>,
+    /// Plain text rows, top to bottom.
+    pub(crate) rows: Vec<String>,
+}
+
+impl FooterPlaceholder {
+    /// Rows to draw at `columns`: the recorded text at the recorded width, or
+    /// blank rows of the same height at any other width so the layout holds.
+    pub(crate) fn rows_for(&self, columns: u16) -> Vec<String> {
+        if columns == self.columns {
+            self.rows.clone()
+        } else {
+            vec![String::new(); self.rows.len()]
+        }
+    }
+
+    pub(crate) fn load(workspace: &Path) -> Option<Self> {
+        Self::load_from(&cache_path(workspace)?)
+    }
+
+    pub(crate) fn store(&self, workspace: &Path) {
+        if let Some(path) = cache_path(workspace) {
+            self.store_to(&path);
+        }
+    }
+
+    fn load_from(path: &Path) -> Option<Self> {
+        let cached: Self = serde_json::from_slice(&std::fs::read(path).ok()?).ok()?;
+        cached.is_bounded().then_some(cached)
+    }
+
+    /// Best effort: a cache that cannot be written only costs the placeholder.
+    fn store_to(&self, path: &Path) {
+        if !self.is_bounded() {
+            return;
+        }
+        let Some(parent) = path.parent() else { return };
+        let Ok(bytes) = serde_json::to_vec(self) else {
+            return;
+        };
+        if std::fs::create_dir_all(parent).is_err() {
+            return;
+        }
+        let temporary = path.with_extension(format!("{}.tmp", std::process::id()));
+        if std::fs::write(&temporary, bytes).is_ok() && std::fs::rename(&temporary, path).is_err() {
+            let _ = std::fs::remove_file(&temporary);
+        }
+    }
+
+    fn is_bounded(&self) -> bool {
+        !self.rows.is_empty()
+            && self.rows.len() <= MAX_ROWS
+            && self.rows.iter().all(|row| row.len() <= MAX_ROW_BYTES)
+            && self.rows.iter().any(|row| !row.trim().is_empty())
+    }
+}
+
+fn cache_path(workspace: &Path) -> Option<PathBuf> {
+    let digest = Sha256::digest(workspace.to_string_lossy().as_bytes());
+    let key: String = digest[..12].iter().map(|byte| format!("{byte:02x}")).collect();
+    Some(
+        dirs::home_dir()
+            .filter(|home| home.is_absolute())?
+            .join(".octet/cache/footer")
+            .join(format!("{key}.json")),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn sample() -> FooterPlaceholder {
+        FooterPlaceholder {
+            columns: 80,
+            extensions: vec!["pi".into()],
+            rows: vec!["~/work   Model 0/272K (0%)".into()],
+        }
+    }
+
+    #[test]
+    fn rows_hold_the_height_at_another_width() {
+        let footer = sample();
+        assert_eq!(footer.rows_for(80), footer.rows);
+        assert_eq!(footer.rows_for(100), vec![String::new()]);
+    }
+
+    #[test]
+    fn unbounded_or_empty_footers_are_not_cached() {
+        let mut footer = sample();
+        footer.rows = vec!["x".repeat(MAX_ROW_BYTES + 1)];
+        assert!(!footer.is_bounded());
+        footer.rows = vec!["  ".into()];
+        assert!(!footer.is_bounded());
+        footer.rows = vec!["a".into(); MAX_ROWS + 1];
+        assert!(!footer.is_bounded());
+    }
+
+    #[test]
+    fn a_stored_footer_round_trips_and_workspaces_do_not_share() {
+        let home = tempfile::tempdir().unwrap();
+        let path = home.path().join("nested/footer.json");
+        assert_eq!(FooterPlaceholder::load_from(&path), None);
+        sample().store_to(&path);
+        assert_eq!(FooterPlaceholder::load_from(&path), Some(sample()));
+        std::fs::write(&path, b"not json").unwrap();
+        assert_eq!(FooterPlaceholder::load_from(&path), None);
+        assert_ne!(cache_path(Path::new("/a")), cache_path(Path::new("/b")));
+    }
+}
