+/// Plain text of the extension footer once it has painted at this geometry.
+pub(super) fn live_footer_rows(
+    projection: &Projection,
+    width: u16,
+    height: u16,
+) -> Option<Vec<String>> {
+    let mount = projection.mount(Placement::Footer)?;
+    let rows: Vec<String> = projection
+        .lines(mount, width, height)
+        .iter()
+        .map(|line| {
+            sexy_tui_rs::strip_terminal_sequences(&truncate_to_width(
+                line,
+                usize::from(width),
+                Some(""),
+            ))
+        })
+        .collect();
+    (!rows.is_empty()).then_some(rows)
+}
+
+/// The dimmed placeholder rows for the footer, while an extension footer is
+/// expected but has not painted.
+fn placeholder_rows(state: &ShellState, width: u16) -> Option<Vec<String>> {
+    let placeholder = state.footer_placeholder.as_ref()?;
+    Some(
+        placeholder
+            .rows_for(width)
+            .iter()
+            .map(|row| super::fit_line(&state.theme.dim(row), width))
+            .collect(),
+    )
+}
