diff --git a/docs/maintainers/pi-usability-wip/R-commits/0002-pi-compat-keep-shared-closure-files-with-their-live-.patch b/docs/maintainers/pi-usability-wip/R-commits/0002-pi-compat-keep-shared-closure-files-with-their-live-.patch
