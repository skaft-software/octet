diff --git a/docs/maintainers/pi-usability-wip/R-commits/0003-pi-compat-fingerprint-every-package.json-up-to-the-d.patch b/docs/maintainers/pi-usability-wip/R-commits/0003-pi-compat-fingerprint-every-package.json-up-to-the-d.patch
