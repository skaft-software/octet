--- /dev/null
+++ b/docs/maintainers/pi-usability-wip/R-commits/0003-pi-compat-fingerprint-every-package.json-up-to-the-d.patch
@@ -0,0 +1,82 @@
+From 7dab969b536d5113e8a896e8fbb49fa8e47dec09 Mon Sep 17 00:00:00 2001
+From: Claude <noreply@anthropic.com>
+Date: Tue, 3 Nov 2026 03:36:27 +0000
+Subject: [PATCH 3/3] pi-compat: fingerprint every package.json up to the
+ dependency root in the resolve cache
+
+A nested {"type":"module"} stopped the walk, so an edited exports map in the
+package's own package.json left a stale cached resolution.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ .../lib/jiti-resolve-cache.mjs                | 10 ++++++---
+ .../test/jiti-resolve-cache.test.mjs          | 21 ++++++++++++++++++-
+ 2 files changed, 27 insertions(+), 4 deletions(-)
+
+diff --git a/extensions/octet-pi-compat/lib/jiti-resolve-cache.mjs b/extensions/octet-pi-compat/lib/jiti-resolve-cache.mjs
+index 8cc03ccf..2e7234f1 100644
+--- a/extensions/octet-pi-compat/lib/jiti-resolve-cache.mjs
++++ b/extensions/octet-pi-compat/lib/jiti-resolve-cache.mjs
+@@ -1,7 +1,7 @@
+ import { createRequire } from 'node:module';
+ import { createHash } from 'node:crypto';
+-import { readFileSync, statSync } from 'node:fs';
+-import { dirname, isAbsolute, join } from 'node:path';
++import { existsSync, readFileSync, statSync } from 'node:fs';
++import { basename, dirname, isAbsolute, join } from 'node:path';
+ import { fileURLToPath } from 'node:url';
+ import { createJiti as stockCreateJiti } from 'jiti';
+ import { readPersisted, writePersisted } from './startup-cache.mjs';
+@@ -101,9 +101,13 @@ class ResolveCache {
+         }
+       }
+     }
++    // Inside a dependency, every package.json up to the package root counts: a
++    // nested `{"type":"module"}` must not hide an edited `exports` map above it.
++    const dependency = resolved.includes('/node_modules/');
++    const packageRoot = dir => { const scope = dirname(dir); return basename(scope) === 'node_modules' || (basename(scope).startsWith('@') && basename(dirname(scope)) === 'node_modules'); };
+     for (let dir = dirname(resolved), last; dir !== last; last = dir, dir = dirname(dir)) {
+       out.add(join(dir, 'package.json'));
+-      try { statSync(join(dir, 'package.json')); break; } catch { /* keep walking up */ }
++      if (dependency ? packageRoot(dir) : existsSync(join(dir, 'package.json'))) break;
+     }
+     return out;
+   }
+diff --git a/extensions/octet-pi-compat/test/jiti-resolve-cache.test.mjs b/extensions/octet-pi-compat/test/jiti-resolve-cache.test.mjs
+index bc01cf5c..454e7154 100644
+--- a/extensions/octet-pi-compat/test/jiti-resolve-cache.test.mjs
++++ b/extensions/octet-pi-compat/test/jiti-resolve-cache.test.mjs
+@@ -1,6 +1,6 @@
+ import test from 'node:test';
+ import assert from 'node:assert/strict';
+-import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
++import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+ import { spawnSync } from 'node:child_process';
+ import { tmpdir } from 'node:os';
+ import { join } from 'node:path';
+@@ -70,3 +70,22 @@ test('cold and warm resolution keep different alias targets separate and corrupt
+   writeFileSync(cacheFile, '{broken');
+   assert.deepEqual(run(script), ['shim', 'installed']);
+ });
++
++test('editing the governing package.json invalidates a resolution that stopped at a nested one', t => {
++  const { dir, run } = fixture(t);
++  const lib = join(dir, 'node_modules', '@scope', 'foo', 'lib'), manifest = join(dir, 'node_modules', '@scope', 'foo', 'package.json');
++  mkdirSync(lib, { recursive: true });
++  writeFileSync(join(lib, 'package.json'), '{"type":"module"}');
++  for (const name of ['a', 'b']) writeFileSync(join(lib, `${name}.mjs`), `export default ${JSON.stringify(name)};`);
++  writeFileSync(manifest, '{"name":"@scope/foo","exports":"./lib/a.mjs"}');
++  writeFileSync(join(dir, 'entry.ts'), "import foo from '@scope/foo'; export default foo as string;");
++  const script = `
++    import { createJiti, flushResolveCache } from ${JSON.stringify(moduleUrl)};
++    const jiti = createJiti(import.meta.url, { moduleCache: false, tryNative: false });
++    console.log(JSON.stringify(await jiti.import(${JSON.stringify(join(dir, 'entry.ts'))}, { default: true })));
++    flushResolveCache();
++  `;
++  assert.equal(run(script), 'a');
++  writeFileSync(manifest, '{"name":"@scope/foo","exports":"./lib/b.mjs"}');
++  assert.equal(run(script), 'b');
++});
+-- 
+2.43.0
+
diff --git a/extensions/octet-pi-compat/lib/startup-cache.mjs b/extensions/octet-pi-compat/lib/startup-cache.mjs
index 521b0666..eb5cfa45 100644
--- a/extensions/octet-pi-compat/lib/startup-cache.mjs
+++ b/extensions/octet-pi-compat/lib/startup-cache.mjs
@@ -1,4 +1,4 @@
-import { accessSync, constants, mkdirSync, readFileSync, renameSync, statSync, writeFileSync } from 'node:fs';
+import { accessSync, constants, mkdirSync, readFileSync, renameSync, statSync, unlinkSync, writeFileSync } from 'node:fs';
 import { homedir } from 'node:os';
 import { join } from 'node:path';
 import module from 'node:module';
@@ -94,8 +94,14 @@ export function writePersisted(name, value, maxBytes = 16 * 1024 * 1024) {
     const text = JSON.stringify(value);
     if (Buffer.byteLength(text) > maxBytes) return false;
     const file = join(directory, name), temporary = `${file}.${process.pid}.tmp`;
-    writeFileSync(temporary, text, { mode: 0o600 });
-    renameSync(temporary, file);
+    try {
+      writeFileSync(temporary, text, { mode: 0o600 });
+      renameSync(temporary, file);
+    } catch (error) {
+      // The name is per process, so a leftover from a full disk would never be reused.
+      try { unlinkSync(temporary); } catch { /* nothing was written */ }
+      throw error;
+    }
     return true;
   } catch { return false; }
 }
