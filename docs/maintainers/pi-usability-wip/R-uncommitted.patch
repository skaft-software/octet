index 00000000..156142d5
--- /dev/null
+++ b/docs/maintainers/pi-usability-wip/R-commits/0002-pi-compat-keep-shared-closure-files-with-their-live-.patch
@@ -0,0 +1,63 @@
+From 970c482c4f950621d7fdc5f60cd5ad4eb1e4d262 Mon Sep 17 00:00:00 2001
+From: Claude <noreply@anthropic.com>
+Date: Tue, 3 Nov 2026 03:26:02 +0000
+Subject: [PATCH 2/3] pi-compat: keep shared closure files with their live
+ native scope
+
+A later factory's declined probe re-pointed shared files at its disabled
+scope, so the live factory lost alias resolution and the digest check for
+later lazy imports.
+
+Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
+Claude-Session: https://claude.ai/code/session_01SJg4KTSPzhSXgwjtDWqAnQ
+---
+ extensions/octet-pi-compat/lib/native-esm.mjs  |  6 +++++-
+ .../octet-pi-compat/test/native-esm.test.mjs   | 18 ++++++++++++++++++
+ 2 files changed, 23 insertions(+), 1 deletion(-)
+
+diff --git a/extensions/octet-pi-compat/lib/native-esm.mjs b/extensions/octet-pi-compat/lib/native-esm.mjs
+index cf427f99..492d5180 100644
+--- a/extensions/octet-pi-compat/lib/native-esm.mjs
++++ b/extensions/octet-pi-compat/lib/native-esm.mjs
+@@ -169,7 +169,11 @@ export class NativeEsm {
+     if (reason) { tracePhase('adapter.native.ineligible', reason); return false; }
+     this.install();
+     const scope = { id: this.nextId++, state: 'probing' };
+-    for (const [path, hash] of Object.entries(hashes)) this.files.set(pathToFileURL(path).href, { path, hash, scope });
++    for (const [path, hash] of Object.entries(hashes)) {
++      // A file shared with an earlier factory stays with that scope: a later probe that declines must not strip its alias resolution and digest check.
++      const url = pathToFileURL(path).href;
++      if (!this.active(url)) this.files.set(url, { path, hash, scope });
++    }
+     try {
+       await import(pathToFileURL(entry).href);
+       scope.state = 'live';
+diff --git a/extensions/octet-pi-compat/test/native-esm.test.mjs b/extensions/octet-pi-compat/test/native-esm.test.mjs
+index 087ed3b6..2f3853d1 100644
+--- a/extensions/octet-pi-compat/test/native-esm.test.mjs
++++ b/extensions/octet-pi-compat/test/native-esm.test.mjs
+@@ -118,3 +118,21 @@ test('a live scope keeps resolving aliases for later dynamic imports from the cl
+   const { later } = await import(pathToFileURL(entry).href);
+   assert.equal(await later(), await import(pathToFileURL(aliases[CODING]).href));
+ });
++
++test('a declined probe does not strip a live scope of the files they share', async t => {
++  const dir = project({
++    'util.js': `export const later = () => import('${CODING}');`,
++    'a.js': "import { later } from './util.js'; export default () => {}; export { later };",
++    'b.js': "import './util.js'; import 'cjsdep'; export default () => {};",
++  });
++  mkdirSync(join(dir, 'node_modules', 'cjsdep'), { recursive: true });
++  writeFileSync(join(dir, 'node_modules', 'cjsdep', 'package.json'), '{"name":"cjsdep","main":"index.js"}');
++  writeFileSync(join(dir, 'node_modules', 'cjsdep', 'index.js'), 'module.exports = 1;');
++  t.after(() => rmSync(dir, { recursive: true, force: true }));
++  const { native } = setup();
++  const a = join(dir, 'a.js'), b = join(dir, 'b.js');
++  assert.equal(await native.attempt(a, reviewedSourceHashes(a)), true);
++  assert.equal(await native.attempt(b, reviewedSourceHashes(b)), false);
++  const { later } = await import(pathToFileURL(a).href);
++  assert.equal(await later(), await import(pathToFileURL(aliases[CODING]).href));
++});
+-- 
