+    c.add_argument("--rows", type=int, default=6)
+    c.add_argument("--width", type=int, default=150)
     args = parser.parse_args(argv)
+    if args.cmd == "compare":
+        compare(args)
+        return 0
     if args.cmd == "record":
         print(json.dumps(record(args), indent=1))
     else:
