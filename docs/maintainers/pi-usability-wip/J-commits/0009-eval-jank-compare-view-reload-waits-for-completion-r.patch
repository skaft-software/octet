+def _await_reload(s, n) -> None:
+    """The sentinel's marker leaves the screen when the reload starts and returns when it has finished."""
+    end = time.monotonic() + 15
+    while time.monotonic() < end and core.READY_MARKER in s.screen_text():
+        time.sleep(0.01)
+    n["reload_started"] = s.now()
+    n["reload_done"] = s.wait_text(core.READY_MARKER)
+    time.sleep(3)
+
