@@ -411,6 +433,45 @@ def show_at(directory: Path, at: float) -> str:
     return last
 
 
+def screen_at(directory: Path, at: float):
+    last = None
+    for t, _, screen in replay(directory):
+        if t > at:
+            break
+        last = screen
+    return last
+
+
+def row_segments(screen, y: int) -> list[tuple[str, str]]:
+    """Runs of equally styled cells in one row, as (text, "fg/bg/attrs")."""
+    runs: list[tuple[str, str]] = []
+    for x in range(screen.columns):
+        char, style = screen.cell(x, y)
+        key = "/".join(filter(None, [
+            "fg%02x%02x%02x" % style.fg if style.fg else "", "bg%02x%02x%02x" % style.bg if style.bg else "",
+            *(name for name in ("bold", "italic", "underline", "reverse", "dim") if getattr(style, name))]))
+        if runs and runs[-1][1] == key:
+            runs[-1] = (runs[-1][0] + char, key)
+        else:
+            runs.append((char, key))
+    return [(text.rstrip() if i == len(runs) - 1 else text, key) for i, (text, key) in enumerate(runs) if text.strip() or key]
+
+
+def compare(args) -> None:
+    """Last N rows of two recordings at the given times; rows whose text or colours differ are marked."""
+    a, b = (screen_at(Path(d), t) for d, t in ((args.a, args.at_a), (args.b, args.at_b)))
+    for offset in range(args.rows, 0, -1):
+        ya, yb = a.rows - offset, b.rows - offset
+        sa, sb = row_segments(a, ya), row_segments(b, yb)
+        same_text, same_style = a.row(ya) == b.row(yb), sa == sb
+        mark = "  " if same_text and same_style else ("~ " if same_text else "! ")
+        print(f"{mark}A| {a.row(ya)[:args.width]}")
+        print(f"{mark}B| {b.row(yb)[:args.width]}")
+        if same_text and not same_style:
+            print(f"   A styles: {[(t[:12], k) for t, k in sa][:6]}")
+            print(f"   B styles: {[(t[:12], k) for t, k in sb][:6]}")
+
+
 def diff(args) -> None:
