@@ -373,18 +441,41 @@ def load_frames(directory: Path):
     return outs, ins
 
 
+SYNC = re.compile(rb"(\x1b\[\?2026[hl])")
+
+
 def replay(directory: Path):
-    """Yield (t, rows_text, screen) after every PTY write, applying recorded resizes."""
+    """Yield (t, rows_text, screen) at every point a terminal could paint.
+
+    Both products bracket frames in synchronized output (CSI ?2026 h ... l), so a state inside a
+    bracket is never visible: states are taken at each closing `l` and at the end of a write that
+    is not inside a bracket. Recorded resizes are applied at their timestamps."""
     screen = Screen(run.COLUMNS, run.ROWS)
     meta = json.loads((directory / "meta.json").read_text())
     resizes = sorted((meta[k], k) for k in meta if k.startswith("resize_"))
+    synchronized = False
+
+    def snapshot(t):
+        screen.responses = []
+        return t, [line.rstrip() for line in screen.text().split("\n")], screen
+
     for t, data in load_frames(directory)[0]:
         while resizes and resizes[0][0] <= t:
             cols, rows = resizes.pop(0)[1][len("resize_"):].split("x")
             screen.resize(int(cols), int(rows))
-        screen.feed(data)
-        screen.responses = []
-        yield t, [line.rstrip() for line in screen.text().split("\n")], screen
+        dirty = False
+        for piece in SYNC.split(data):
+            if piece == b"\x1b[?2026h":
+                synchronized = True
+            elif piece == b"\x1b[?2026l":
+                synchronized = False
+                yield snapshot(t)
+                dirty = False
+            elif piece:
+                screen.feed(piece)
+                dirty = True
+        if dirty and not synchronized:
+            yield snapshot(t)
 
 
 def summarize(directory: Path) -> dict:
