 import shutil
 import signal
@@ -155,6 +156,55 @@ def sc_prompt_idle(s, p, n):
     time.sleep(2)
 
 
+def sc_tool(s, p, n):
+    n["ready"] = s.wait_text(core.READY_MARKER)
+    notes = s.cwd / "notes.txt"
+    notes.write_text("alpha\nbeta\ngamma\n")
+    with p._lock:
+        p._rules.clear()
+    p.rule(lambda r: any(m.get("role") == "tool" for m in r.messages), lambda r: Reply(text="REPLY-OK after tool"))
+    p.rule(lambda r: True, lambda r: Reply(text="Reading the file.", tool_calls=(("read", json.dumps({"path": str(notes)})),)))
+    n["sent"] = s.now()
+    s.write("read notes.txt\r")
+    n["permission"] = s.wait_text("Permission Required", 15)
+    if n["permission"]:
+        time.sleep(1)
+        s.write("y")
+        time.sleep(0.2)
+        s.write("y")
+    n["reply"] = s.wait_text("REPLY-OK after tool", 40)
+    time.sleep(2)
+
+
+COMMANDS = [
+    "answer", "bg", "bg-tasks", "btw", "claude-cache", "context-simple", "control-sessions", "curator", "end-review", "files", "fusion",
+    "fusion-models", "google-account", "handoff", "jobs", "learn-memory-tool", "lens-health", "lens-map", "lens-perf", "lens-tools",
+    "lens-widget-toggle", "llama", "logs", "loop", "mcp", "mcp-auth", "memory-insights", "memory-skills", "pi-mcp", "permission-system",
+    "prompt-workflow", "review", "run", "search", "session-breakdown", "sessions", "subagent-cost", "subagents", "subagents-doctor",
+    "subagents-fleet", "subagents-guide", "subagents-models", "subagents-profiles", "tasks", "todos", "toggle-auto-read", "websearch",
+    "whimsy", "workflow",
+]
+
+
+def sc_commands(s, p, n):
+    """Each extension command, one at a time; kill/exit/bye/termdraw (which take over the terminal) are left out."""
+    n["ready"] = s.wait_text(core.READY_MARKER)
+    time.sleep(3)
+    for name in COMMANDS:
+        n[f"cmd_{name}"] = s.now()
+        s.write(f"/{name}")
+        time.sleep(0.4)
+        s.write("\r")
+        time.sleep(1.5)
+        n[f"cmd_{name}_end"] = s.now()
+        s.write("\x1b")
+        time.sleep(0.2)
+        s.write("\x1b")
+        time.sleep(0.2)
+        s.write("\x15")
+        time.sleep(0.3)
+
+
 def sc_back_to_back(s, p, n):
     n["ready"] = s.wait_text(core.READY_MARKER)
     _script(p, Reply(text="REPLY-OK one two three four five six seven eight", chunk_delay=0.25))
@@ -210,6 +260,18 @@ def _await_reload(s, n) -> None:
     time.sleep(3)
 
 
+def sc_slash_pkg(s, p, n):
+    """Prompt templates and skills that ship in the bigpowers package: are they in the menu?"""
+    n["ready"] = s.wait_text(core.READY_MARKER)
+    time.sleep(2)
+    for name in ("/align-grid", "/skill:align", "/audit"):
+        n[f"query_{name[1:]}"] = s.now()
+        _typed(s, name, 0.05)
+        time.sleep(1.5)
+        s.write("\x15")
+        time.sleep(0.5)
+
+
 def sc_reload(s, p, n):
     n["ready"] = s.wait_text(core.READY_MARKER)
     time.sleep(2)
