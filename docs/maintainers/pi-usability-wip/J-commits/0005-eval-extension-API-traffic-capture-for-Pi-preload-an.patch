@@ -0,0 +1,71 @@
+import { appendFileSync } from 'node:fs';
+
+// Opt-in recorder of the traffic between a Pi host and its extensions, for side-by-side comparison
+// (scripts/pi-eval/jank.py). It logs every call an extension makes on the API, every event delivered
+// to a handler, and every call a handler makes on the context it received, with the time each took
+// (settled time for promises). Off unless OCTET_PI_API_TRACE names the output file.
+const out = process.env.OCTET_PI_API_TRACE;
+export const apiTraceEnabled = Boolean(out);
+const started = performance.now();
+
+const clip = (value) => {
+  try {
+    const text = typeof value === 'string' ? value : JSON.stringify(value, (_, v) => (typeof v === 'function' ? '[fn]' : v));
+    return text === undefined ? String(value) : text.length > 160 ? `${text.slice(0, 160)}...` : text;
+  } catch {
+    return '[unserialisable]';
+  }
+};
+const log = (row) => appendFileSync(out, `${JSON.stringify({ t: +((performance.now() - started) / 1000).toFixed(4), w: Date.now() / 1000, ...row })}\n`);
+export const extensionLabel = (entry) => String(entry).split('node_modules/').pop().split('/').slice(-4).join('/');
+
+function timed(kind, ext, name, args, run) {
+  const begin = performance.now();
+  const finish = (note) => log({ k: kind, ext, n: name, a: args.map(clip), d: +(performance.now() - begin).toFixed(1), ...note });
+  try {
+    const result = run();
+    if (result && typeof result.then === 'function') {
+      return result.then((value) => (finish({ async: true }), value), (error) => (finish({ async: true, err: String(error?.message ?? error).slice(0, 120) }), Promise.reject(error)));
+    }
+    finish({});
+    return result;
+  } catch (error) {
+    finish({ err: String(error?.message ?? error).slice(0, 120) });
+    throw error;
+  }
+}
+
+export function traceContext(target, ext, path = 'ctx') {
+  if (!apiTraceEnabled || !target || typeof target !== 'object') return target;
+  return new Proxy(target, {
+    get(object, key) {
+      const value = Reflect.get(object, key, object);
+      if (typeof key !== 'string') return value;
+      if (typeof value === 'function') return (...args) => timed('ctx', ext, `${path}.${key}`, args, () => value.apply(object, args));
+      if (value && typeof value === 'object' && !Array.isArray(value)) return traceContext(value, ext, `${path}.${key}`);
+      return value;
+    },
+  });
+}
+
+export const traceHandler = (ext, event, handler) => (payload, ctx) => timed('event', ext, event, [payload], () => handler(payload, traceContext(ctx, ext)));
+
+export function traceAPI(api, ext) {
+  if (!apiTraceEnabled) return api;
+  return new Proxy(api, {
+    get(object, key) {
+      const value = Reflect.get(object, key, object);
+      if (typeof key !== 'string' || typeof value !== 'function') return value;
+      if (key === 'on') return (event, handler, ...rest) => (log({ k: 'api', ext, n: `on:${event}` }), value.call(object, event, traceHandler(ext, event, handler), ...rest));
+      if (key === 'registerCommand') {
+        return (name, def) => (log({ k: 'api', ext, n: `registerCommand:${name}` }),
+          value.call(object, name, typeof def?.handler === 'function' ? { ...def, handler: (args, ctx) => timed('command', ext, name, [args], () => def.handler(args, traceContext(ctx, ext))) } : def));
+      }
+      if (key === 'registerTool') {
+        return (def) => (log({ k: 'api', ext, n: `registerTool:${def?.name}` }),
+          value.call(object, typeof def?.execute === 'function' ? { ...def, execute: (...args) => timed('tool', ext, def.name, [args[1]], () => def.execute(...args)) } : def));
+      }
+      return (...args) => timed('api', ext, key, args, () => value.apply(object, args));
+    },
+  });
+}
