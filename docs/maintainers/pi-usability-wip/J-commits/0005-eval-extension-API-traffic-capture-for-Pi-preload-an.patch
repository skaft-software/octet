@@ -0,0 +1,23 @@
+// Node `--import` preload for the jank recorder: logs the traffic between Pi 1.4.0 and its extensions
+// into $OCTET_PI_API_TRACE, in the same format octet's adapter writes (lib/api-trace.mjs).
+//
+// Pi's bundle is minified, so the seam is a source rewrite in memory (Pi's files are never touched):
+// `await factory(load.api)` becomes `await factory(globalThis.__jankApi(load.api, extensionPath))`.
+import { register } from "node:module";
+import { isMainThread } from "node:worker_threads";
+
+const SEAM = "await factory(load.api)";
+
+if (isMainThread && !globalThis.__jankApi) {
+  const { extensionLabel, traceAPI } = await import("../../extensions/octet-pi-compat/lib/api-trace.mjs");
+  globalThis.__jankApi = (api, path) => traceAPI(api, extensionLabel(path));
+  register(import.meta.url);
+}
+
+export async function load(url, context, nextLoad) {
+  const result = await nextLoad(url, context);
+  if (!url.includes("/dist/bundle/chunks/") || result.format !== "module") return result;
+  const source = String(result.source);
+  if (!source.includes(SEAM)) return result;
+  return { ...result, source: source.replace(SEAM, "await factory(globalThis.__jankApi(load.api,extensionPath))") };
+}
