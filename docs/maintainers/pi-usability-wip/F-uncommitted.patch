+
+#[tokio::test]
+async fn footer_placeholder_is_the_footer_of_the_first_rendered_frames() {
+    let (mut shell, _) =
+        crate::tui::view::tests::emulated_shell(crate::tui::theme::test_theme(), 80, 24);
+    shell.set_identity("custom", "custom/probe", "off");
+    shell.set_footer_placeholder(Some(placeholder(80, "PLACEHOLDER-FOOTER")));
+    for finished in [false, true] {
+        if finished {
+            shell.finish_startup();
+        }
+        shell.render();
+        let frame = shell.dump_rendered_frame().await.unwrap();
+        let text = frame
+            .iter()
+            .map(|row| sexy_tui_rs::strip_terminal_sequences(row))
+            .collect::<Vec<_>>();
+        let last = text.iter().rposition(|row| !row.trim().is_empty()).unwrap();
+        assert!(
+            text[last].contains("PLACEHOLDER-FOOTER"),
+            "finished={finished}: {text:?}"
+        );
+        assert!(!text.iter().any(|row| row.contains("probe")), "{text:?}");
+    }
+}
