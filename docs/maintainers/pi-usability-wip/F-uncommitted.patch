--- a/crates/octet-coding-agent/src/tui/view/remote_ui/tests.rs
+++ b/crates/octet-coding-agent/src/tui/view/remote_ui/tests.rs
@@ -449,3 +449,28 @@ fn placeholder_is_kept_only_for_the_extensions_it_was_recorded_with() {
