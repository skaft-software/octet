+fn placeholder(columns: u16, text: &str) -> crate::tui::footer_placeholder::FooterPlaceholder {
+    crate::tui::footer_placeholder::FooterPlaceholder {
+        columns,
+        extensions: vec!["pi".into()],
+        rows: vec![text.into()],
+    }
+}
+
+#[test]
+fn footer_placeholder_takes_the_built_in_footer_row_until_the_live_footer_paints() {
+    let size = (80, 24);
+    let mut state = ShellState {
+        size,
+        ..ShellState::default()
+    };
+    let builtin = shell_chrome(&state, size.0, Instant::now());
+    assert!(builtin.extension_below.is_empty());
+
+    state.footer_placeholder = Some(placeholder(size.0, "~/work  Model 0/272K"));
+    let dimmed = shell_chrome(&state, size.0, Instant::now());
+    assert_eq!(dimmed.composer.len() + 1, builtin.composer.len());
+    assert_eq!(dimmed.extension_below.len(), 1);
+    assert!(dimmed.extension_below[0].contains("~/work  Model 0/272K"));
+    assert_eq!(dimmed.transcript_rows, builtin.transcript_rows);
+
+    // The footer is mounted but has not painted: the placeholder stays, no blank row.
+    let mut remote = projection(size, &[(Placement::Footer, "live footer")]);
+    Arc::make_mut(&mut remote.components)
+        .store_render(&remote.mounts[0].id, size.0, Vec::new())
+        .unwrap();
+    state.extension_ui.remote = remote;
+    assert_eq!(
+        shell_chrome(&state, size.0, Instant::now()).extension_below,
+        dimmed.extension_below
+    );
+
+    // The live footer replaces it in the same row.
+    state.extension_ui.remote = projection(size, &[(Placement::Footer, "live footer")]);
+    let live = shell_chrome(&state, size.0, Instant::now());
+    assert_eq!(live.extension_below, vec!["live footer\x1b[0m"]);
+    assert_eq!(live.composer, dimmed.composer);
+    assert_eq!(live.transcript_rows, dimmed.transcript_rows);
+}
+
+#[test]
+fn unpainted_footer_without_a_placeholder_keeps_the_built_in_footer() {
+    let size = (80, 24);
+    let mut state = ShellState {
+        size,
+        ..ShellState::default()
+    };
+    let builtin = shell_chrome(&state, size.0, Instant::now());
+    let mut remote = projection(size, &[(Placement::Footer, "live footer")]);
+    Arc::make_mut(&mut remote.components)
+        .store_render(&remote.mounts[0].id, size.0, Vec::new())
+        .unwrap();
+    state.extension_ui.remote = remote;
+    let mounted = shell_chrome(&state, size.0, Instant::now());
+    assert_eq!(mounted.composer, builtin.composer);
+    assert!(mounted.extension_below.is_empty());
+}
+
+#[test]
+fn footer_placeholder_keeps_its_height_at_another_width_and_fills_the_startup_row() {
+    let size = (80, 24);
+    let mut state = ShellState {
+        size,
+        ..ShellState::default()
+    };
+    state.footer_placeholder = Some(placeholder(100, "recorded at another width"));
+    let rows = shell_chrome(&state, size.0, Instant::now()).extension_below;
+    assert_eq!(rows.len(), 1);
+    assert!(!rows[0].contains("recorded"));
+
+    state.footer_placeholder = Some(placeholder(size.0, "startup footer"));
+    state.startup_pending = true;
+    let chrome = shell_chrome(&state, size.0, Instant::now());
+    assert!(chrome.extension_below[0].contains("startup footer"));
+    assert!(chrome
+        .composer
+        .iter()
+        .all(|row| !row.contains("startup footer")));
+}
+
+#[test]
+fn live_footer_paint_drops_the_placeholder() {
+    let mut shell = super::super::InteractiveShell::test_shell();
+    let size = shell.terminal_dimensions();
+    shell.set_footer_placeholder(Some(placeholder(size.0, "old footer")));
+    shell.set_remote_ui(projection(size, &[(Placement::BelowEditor, "widget")]));
+    assert!(shell.state.borrow().footer_placeholder.is_some());
+    shell.set_remote_ui(projection(size, &[(Placement::Footer, "live footer")]));
+    assert!(shell.state.borrow().footer_placeholder.is_none());
+    assert_eq!(shell.live_footer_text().unwrap().rows, vec!["live footer"]);
+}
+
+#[test]
+fn placeholder_is_kept_only_for_the_extensions_it_was_recorded_with() {
+    let mut shell = super::super::InteractiveShell::test_shell();
+    shell.set_footer_placeholder(Some(placeholder(80, "footer")));
+    shell.retain_footer_placeholder_for(&["pi".into()]);
+    assert!(shell.state.borrow().footer_placeholder.is_some());
+    shell.retain_footer_placeholder_for(&["pi".into(), "other".into()]);
+    assert!(shell.state.borrow().footer_placeholder.is_none());
+}
