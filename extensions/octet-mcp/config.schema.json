{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skaft.org/octet/extensions/octet-mcp/config.schema.json",
  "title": "octet-mcp configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "servers"],
  "properties": {
    "version": {"const": 1},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxServers": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxToolsPerServer": {"type": "integer", "minimum": 1, "maximum": 128},
        "maxTotalTools": {"type": "integer", "minimum": 1, "maximum": 256},
        "maxCatalogPages": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxFrameBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "maxResultBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "maxLogEntries": {"type": "integer", "minimum": 1, "maximum": 1024},
        "maxLogLineBytes": {"type": "integer", "minimum": 128, "maximum": 16384},
        "maxPendingRequestsPerServer": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxConcurrentCalls": {"type": "integer", "minimum": 1, "maximum": 32},
        "startupTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "requestTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 120000},
        "shutdownTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 5000},
        "cancellationGraceMs": {"type": "integer", "minimum": 1, "maximum": 2000},
        "maxRestarts": {"type": "integer", "minimum": 0, "maximum": 8},
        "backoffInitialMs": {"type": "integer", "minimum": 1, "maximum": 5000},
        "backoffMaxMs": {"type": "integer", "minimum": 1, "maximum": 60000}
      }
    },
    "servers": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "additionalProperties": {"$ref": "#/$defs/server"}
    },
    "trustedProjects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "server": {
      "oneOf": [
        {"$ref": "#/$defs/stdioServer"},
        {"$ref": "#/$defs/streamableHttpServer"}
      ]
    },
    "stdioServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "transport": {"const": "stdio"},
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "command": {"type": "string", "minLength": 1, "maxLength": 4096},
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "maxLength": 16384}
        },
        "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
        "env": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "inheritEnv": {
          "description": "Names copied from the bridge process environment into this server. Only reviewed non-secret desktop-session names are accepted; the bridge never forwards arbitrary ambient variables. These are desktop session grants and should be listed only for servers that genuinely need the user's display session.",
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "APPDATA",
              "COMSPEC",
              "DBUS_SESSION_BUS_ADDRESS",
              "DISPLAY",
              "HOME",
              "LOCALAPPDATA",
              "PATHEXT",
              "SYSTEMROOT",
              "USERPROFILE",
              "WAYLAND_DISPLAY",
              "WINDIR",
              "XAUTHORITY",
              "XDG_CONFIG_HOME",
              "XDG_DATA_DIRS",
              "XDG_DATA_HOME",
              "XDG_RUNTIME_DIR",
              "XDG_SESSION_TYPE"
            ]
          }
        },
        "confirmUnknownTools": {
          "description": "Ask the user for confirmation before dispatching any tool this server does not mark readOnly. Off by default; an interactive host denial, cancellation, or non-interactive frontend fails closed rather than assuming approval.",
          "type": "boolean"
        },
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "startupTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "requestTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 120000},
        "maxRestarts": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "streamableHttpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "url"],
      "properties": {
        "transport": {
          "const": "streamable-http",
          "description": "EXPERIMENTAL and blocked by default. Enabling this server also requires the octet process-owner --experimental-streamable-http-mcp CLI flag; no JSON, environment, project, or session field can substitute."
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "format": "uri",
          "description": "Absolute HTTP(S) URL; cleartext HTTP is accepted only for numeric loopback addresses. Queries, fragments, and userinfo are rejected by the strict loader."
        },
        "auth": {
          "description": "Explicit remote credential source. 'bearer' names a logical reference resolved only by an explicitly composed host credential adapter; 'static-bearer' names exactly one extension-scoped OCTET_MCP_* environment variable that the bridge reads per request and never stores, logs, or reports. Neither form accepts or echoes a token value.",
          "oneOf": [{"$ref": "#/$defs/bearerAuth"}, {"$ref": "#/$defs/staticBearerAuth"}]
        },
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "startupTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "requestTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 120000},
        "maxRestarts": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "bearerAuth": {
      "description": "Host-adapter credential reference. The process owner must explicitly compose a credential adapter; the stock runtime resolves nothing and the request fails closed. OAuth/browser authorization stays policy-gated and unimplemented.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "credential"],
      "properties": {
        "type": {"const": "bearer"},
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
        }
      }
    },
    "staticBearerAuth": {
      "description": "Static extension-scoped credential. The bridge reads the named OCTET_MCP_* environment variable at request time; no other variable, dotenv file, keychain, or OAuth flow is consulted, and an unset or unnamespaced name fails closed without echoing the name or value.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "environment"],
      "properties": {
        "type": {"const": "static-bearer"},
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^OCTET_MCP_[A-Z0-9_]{1,48}$"
        }
      }
    }
  }
}
