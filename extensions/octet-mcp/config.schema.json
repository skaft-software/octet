{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skaft.org/octet/extensions/octet-mcp/config.schema.json",
  "title": "octet-mcp configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "servers"],
  "properties": {
    "version": {"const": 1},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxServers": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxToolsPerServer": {"type": "integer", "minimum": 1, "maximum": 128},
        "maxTotalTools": {"type": "integer", "minimum": 1, "maximum": 256},
        "maxCatalogPages": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxFrameBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "maxResultBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
        "maxLogEntries": {"type": "integer", "minimum": 1, "maximum": 1024},
        "maxLogLineBytes": {"type": "integer", "minimum": 128, "maximum": 16384},
        "maxPendingRequestsPerServer": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxConcurrentCalls": {"type": "integer", "minimum": 1, "maximum": 32},
        "startupTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "requestTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 120000},
        "shutdownTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 5000},
        "cancellationGraceMs": {"type": "integer", "minimum": 1, "maximum": 2000},
        "maxRestarts": {"type": "integer", "minimum": 0, "maximum": 8},
        "backoffInitialMs": {"type": "integer", "minimum": 1, "maximum": 5000},
        "backoffMaxMs": {"type": "integer", "minimum": 1, "maximum": 60000}
      }
    },
    "servers": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,31}$"},
      "additionalProperties": {"$ref": "#/$defs/server"}
    },
    "trustedProjects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "server": {
      "oneOf": [
        {"$ref": "#/$defs/stdioServer"},
        {"$ref": "#/$defs/streamableHttpServer"}
      ]
    },
    "stdioServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "transport": {"const": "stdio"},
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "command": {"type": "string", "minLength": 1, "maxLength": 4096},
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "maxLength": 16384}
        },
        "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
        "env": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "startupTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "requestTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 120000},
        "maxRestarts": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "streamableHttpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "url"],
      "properties": {
        "transport": {
          "const": "streamable-http",
          "description": "EXPERIMENTAL and blocked by default. Enabling this server also requires the octet process-owner --experimental-streamable-http-mcp CLI flag; no JSON, environment, project, or session field can substitute."
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 64},
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "format": "uri",
          "description": "Absolute HTTP(S) URL; cleartext HTTP is accepted only for numeric loopback addresses. Queries, fragments, and userinfo are rejected by the strict loader."
        },
        "auth": {"oneOf": [{"$ref": "#/$defs/bearerAuth"}, {"$ref": "#/$defs/oauthAuth"}]},
        "protocolVersion": {"const": "2026-07-28", "description": "Explicit opt-in to the 2026 remote wire; omission preserves legacy negotiation."},
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "startupTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 30000},
        "requestTimeoutMs": {"type": "integer", "minimum": 10, "maximum": 120000},
        "maxRestarts": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    },
    "oauthAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "credential", "issuer", "clientId"],
      "description": "Public pre-registered OAuth client, pinned to the exact HTTPS issuer. Tokens are collected only by explicit trusted user authentication, never from configuration or environment. Private storage is plaintext, not encrypted. DCR and confidential clients are not supported.",
      "properties": {
        "type": {"const": "oauth"},
        "credential": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"},
        "issuer": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://", "format": "uri"},
        "clientId": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[!-~]+$"},
        "scopes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!#-\\[\\]-~]+$"}},
        "redirectPort": {"type": "integer", "minimum": 0, "maximum": 65535, "default": 0, "description": "Registered numeric loopback callback port; zero selects an ephemeral native-client port."}
      }
    },
    "bearerAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "credential"],
      "properties": {
        "type": {"const": "bearer"},
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
        }
      }
    }
  }
}
